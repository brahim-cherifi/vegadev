# BSC RPC URL (Optional - defaults to public endpoint)
BSC_RPC_URL=https://bsc-dataseed.binance.org/

# Your wallet private key (REQUIRED for deployment and interaction)
# NEVER commit your actual private key!
PRIVATE_KEY=your_private_key_here

# BSCScan API Key (Optional - for contract verification)
# Get one at https://bscscan.com/apis
BSCSCAN_API_KEY=your_bscscan_api_key_here

# Contract address (Original - Standard swap to user wallet)
CONTRACT_ADDRESS=0xB6D08194A2c4a41ee353123ff56354fCE221BF79
